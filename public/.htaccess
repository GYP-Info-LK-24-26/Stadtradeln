# Enable URL rewriting
RewriteEngine On

# Set base directory
RewriteBase /

# Don't rewrite existing files and directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Rewrite all other requests to index.php
RewriteRule ^(.*)$ index.php [L,QSA]

# Security: Deny access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# PWA: korrekte MIME-Typen
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

AddType font/woff2 .woff2

# PWA: Service Worker darf nicht gecacht werden, damit Updates ankommen
<IfModule mod_headers.c>
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>

    # Versionierte Assets (?v=<Zeitstempel>, siehe View::asset) dauerhaft cachen,
    # damit Seitenwechsel nicht auf CSS/JS warten müssen
    <FilesMatch "\.(css|js)$">
        <If "%{QUERY_STRING} =~ /(^|&)v=[0-9]+/">
            Header set Cache-Control "public, max-age=31536000, immutable"
        </If>
    </FilesMatch>

    # Schriften und Icons (unversioniert): eine Woche
    <FilesMatch "\.(woff2|png|svg)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>
